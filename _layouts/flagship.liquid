---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {% include project_meta.liquid %}

    {% if page.figures and page.figures.size > 0 %}
      <div class="proj-figures">
        {% for fig in page.figures %}
          <div class="proj-figure">
            {% include figure.liquid loading="eager" path=fig.path class="img-fluid rounded z-depth-1" zoomable=true caption=fig.caption %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="proj-narrative">
      {{ content }}
    </div>
  </article>
</div>
